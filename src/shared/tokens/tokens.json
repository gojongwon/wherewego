{
  "$description": "우리 어디가 디자인 토큰 — 단일 출처. W3C DTCG 형식. 편집 후 `npm run tokens:build` → tokens.css / tokens.ts 재생성. 무드: 낮·종이지도 일러스트 (라이트 단일 테마).",

  "color": {
    "$type": "color",

    "paper": {
      "50":  { "$value": "#FFFCF3", "$description": "시트 표면 (가장 밝은 종이)" },
      "100": { "$value": "#F6EFDC", "$description": "스테이지 배경 (크림)" },
      "200": { "$value": "#EDE3C8", "$description": "틴트" },
      "300": { "$value": "#DCCFAE", "$description": "약한 테두리, 그립" },
      "400": { "$value": "#C4B48D", "$description": "강한 테두리" }
    },
    "ink": {
      "900": { "$value": "#2B2118", "$description": "본문 텍스트, 화살 샤프트" },
      "700": { "$value": "#5C4B3B", "$description": "보조 텍스트" },
      "500": { "$value": "#75634F", "$description": "뮤트 텍스트, 육지 외곽선" },
      "300": { "$value": "#B3A692", "$description": "장식 전용 (텍스트 AA 미달)" }
    },
    "water": {
      "100": { "$value": "#E4EFF2" },
      "200": { "$value": "#CFE2E8", "$description": "물 기본" },
      "300": { "$value": "#B4D0D9", "$description": "깊은 물, 격자" }
    },
    "orange": {
      "100": { "$value": "#FBE3D0" },
      "400": { "$value": "#F3A15F", "$description": "지도 하이라이트" },
      "500": { "$value": "#E8702A", "$description": "primary 채움, 화살촉 (텍스트 배경으론 어두운 글자만)" },
      "700": { "$value": "#A64A12", "$description": "강조 텍스트, 포커스 링" }
    },
    "stamp": {
      "500": { "$value": "#C9432F", "$description": "임팩트 링" },
      "600": { "$value": "#B2372A", "$description": "헛발 텍스트" }
    },
    "land": {
      "sage":  { "$value": "#CFE0B8" },
      "sand":  { "$value": "#F3E3A8" },
      "peach": { "$value": "#F6CDB3" },
      "lilac": { "$value": "#DCD3EA" },
      "mint":  { "$value": "#C6E3DB" }
    },

    "bg": {
      "canvas":  { "$value": "{color.paper.100}" },
      "surface": { "$value": "{color.paper.50}" },
      "inverse": { "$value": "{color.ink.900}" }
    },
    "text": {
      "primary":   { "$value": "{color.ink.900}" },
      "secondary": { "$value": "{color.ink.700}" },
      "muted":     { "$value": "{color.ink.500}" },
      "accent":    { "$value": "{color.orange.700}" },
      "on-accent": { "$value": "{color.ink.900}" },
      "inverse":   { "$value": "{color.paper.50}" },
      "danger":    { "$value": "{color.stamp.600}" }
    },
    "border": {
      "subtle": { "$value": "{color.paper.300}" },
      "strong": { "$value": "{color.paper.400}" }
    },
    "accent": {
      "default": { "$value": "{color.orange.500}" },
      "soft":    { "$value": "{color.orange.100}" },
      "strong":  { "$value": "{color.orange.700}" }
    },
    "focus": { "$value": "{color.orange.700}" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Jua", "Apple SD Gothic Neo", "system-ui", "sans-serif"] },
      "body":    { "$value": ["Gowun Dodum", "Apple SD Gothic Neo", "Noto Sans KR", "system-ui", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "xs":  { "$value": "11px" },
      "sm":  { "$value": "13px" },
      "md":  { "$value": "15px" },
      "lg":  { "$value": "18px" },
      "xl":  { "$value": "22px" },
      "2xl": { "$value": "40px" }
    },
    "line-height": {
      "$type": "number",
      "tight":  { "$value": 1.05 },
      "snug":   { "$value": 1.25 },
      "normal": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "dimension",
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.08em" },
      "wider":  { "$value": "0.12em" }
    }
  },

  "space": {
    "$type": "dimension",
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" }
  },

  "radius": {
    "$type": "dimension",
    "md":   { "$value": "12px" },
    "lg":   { "$value": "20px" },
    "pill": { "$value": "999px" }
  },

  "shadow": {
    "$type": "shadow",
    "paper": { "$value": { "color": "#2B21181F", "offsetX": "0px", "offsetY": "2px",  "blur": "8px",  "spread": "0px" } },
    "lift":  { "$value": { "color": "#2B21182E", "offsetX": "0px", "offsetY": "-8px", "blur": "30px", "spread": "0px" } }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" },
      "slow": { "$value": "380ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.8, 0.2, 1] }
    }
  },

  "map": {
    "$description": "three.js 씬 + 2D 지도 색. tokens.ts로도 나가므로 rgba 문자열 대신 color + number 분리.",
    "paper":      { "$type": "color", "$value": "{color.paper.100}" },
    "water":      { "$type": "color", "$value": "{color.water.200}" },
    "water-deep": { "$type": "color", "$value": "{color.water.300}" },
    "grid":       { "$type": "color", "$value": "{color.water.300}" },
    "land": {
      "$type": "color",
      "0": { "$value": "{color.land.sage}" },
      "1": { "$value": "{color.land.sand}" },
      "2": { "$value": "{color.land.peach}" },
      "3": { "$value": "{color.land.lilac}" },
      "4": { "$value": "{color.land.mint}" }
    },
    "land-edge":  { "$type": "color", "$value": "{color.ink.500}" },
    "highlight":  { "$type": "color", "$value": "{color.orange.400}" },
    "arrow": {
      "$type": "color",
      "ink":    { "$value": "{color.ink.900}" },
      "accent": { "$value": "{color.orange.500}" }
    },
    "impact":     { "$type": "color", "$value": "{color.stamp.500}" },
    "pin-miss":   { "$type": "color", "$value": "{color.ink.500}" },
    "shadow": {
      "color":   { "$type": "color",  "$value": "{color.ink.900}" },
      "opacity": { "$type": "number", "$value": 0.25 }
    }
  },

  "sheet": {
    "bg":      { "$type": "color",     "$value": "{color.bg.surface}" },
    "radius":  { "$type": "dimension", "$value": "{radius.lg}" },
    "shadow":  { "$type": "shadow",    "$value": "{shadow.lift}" },
    "grip":    { "$type": "color",     "$value": "{color.border.strong}" },
    "pad-x":   { "$type": "dimension", "$value": "{space.5}" },
    "pad-top": { "$type": "dimension", "$value": "{space.4}" }
  },

  "button": {
    "height":    { "$type": "dimension", "$value": "44px", "$description": "터치 타깃 (설계서 §10.1)" },
    "radius":    { "$type": "dimension", "$value": "{radius.md}" },
    "font-size": { "$type": "dimension", "$value": "{font.size.md}" },
    "primary": {
      "$type": "color",
      "bg":   { "$value": "{color.accent.default}" },
      "text": { "$value": "{color.text.on-accent}" }
    },
    "ghost": {
      "$type": "color",
      "border": { "$value": "{color.border.strong}" },
      "text":   { "$value": "{color.text.primary}" }
    }
  },

  "toast": {
    "bg":     { "$type": "color",     "$value": "{color.bg.inverse}" },
    "text":   { "$type": "color",     "$value": "{color.text.inverse}" },
    "radius": { "$type": "dimension", "$value": "{radius.pill}" }
  }
}
