{
  "name": "where-we-go",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "우리 어디가 — 지도에 화살을 당겨 쏘아 여행지를 정하는 모바일 웹 게임",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "map:build": "bash scripts/build-map.sh",
    "map:build:jp": "bash scripts/build-map.sh jp",
    "map:build:tw": "bash scripts/build-map.sh tw",
    "map:build:vn": "bash scripts/build-map.sh vn",
    "tokens:build": "node scripts/build-tokens.mjs",
    "prebuild": "npm run tokens:build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "style-dictionary": "^5.5.3",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
